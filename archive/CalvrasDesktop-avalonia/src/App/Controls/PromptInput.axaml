<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Calvras.App.ViewModels"
             x:Class="Calvras.App.Controls.PromptInput"
             x:DataType="vm:WorkspaceViewModel">

    <UserControl.Styles>
        <!-- Flat borderless TextBox with dark text for milky white background -->
        <Style Selector="TextBox.chat-input">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#18181B"/>
            <Setter Property="CaretBrush" Value="#18181B"/>
            <Setter Property="SelectionBrush" Value="#D4D4D8"/>
        </Style>
        <Style Selector="TextBox.chat-input /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.chat-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.chat-input:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Base Composer Border: Collapsed Size (Milky white, reduced height) -->
        <Style Selector="Border.composer-box">
            <Setter Property="Width" Value="340"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Background" Value="#F7F7F4"/>
            <Setter Property="BorderBrush" Value="#E2E2DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow" Value="0 2 12 #10000000"/>
        </Style>

        <!-- Expanded Composer Border (Milky white, compact height) -->
        <Style Selector="Border.composer-box.expanded">
            <Setter Property="Width" Value="580"/>
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="#F7F7F4"/>
            <Setter Property="BorderBrush" Value="#DCDCD6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow" Value="0 4 20 #18000000"/>
        </Style>
    </UserControl.Styles>

    <Grid HorizontalAlignment="Center">
        <StackPanel Spacing="0" HorizontalAlignment="Center">

            <!-- Attachments drawer (slides above composer) -->
            <Border Background="#F7F7F4" BorderBrush="#E2E2DC" BorderThickness="1,1,1,0"
                    CornerRadius="14,14,0,0" Padding="10,6" Margin="10,0,10,0"
                    IsVisible="{Binding AttachedFiles.Count}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding AttachedFiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="46" Height="46" CornerRadius="8" Background="#ECECE8" BorderBrush="#DCDCD6" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="1">
                                            <TextBlock Text="📄" FontSize="13" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding}" FontSize="8" Foreground="#52525B" MaxWidth="38" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Command="{Binding $parent[UserControl].DataContext.RemoveAttachmentCommand}"
                                                CommandParameter="{Binding}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Width="15" Height="15" CornerRadius="7.5" Padding="0" Margin="2"
                                                Background="#71717A" Foreground="White" Cursor="Hand">
                                            <TextBlock Text="✕" FontSize="7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Main composer card with smooth expansion transition -->
            <Border Name="ComposerBorder"
                    Classes="composer-box"
                    Classes.expanded="{Binding IsInputExpanded}"
                    PointerPressed="OnComposerPointerPressed">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                        <DoubleTransition Property="MinHeight" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                    </Transitions>
                </Border.Transitions>

                <Grid RowDefinitions="Auto,Auto">

                    <!-- Text input row -->
                    <Grid Grid.Row="0">
                        <TextBox Name="PromptTextBox"
                                 Classes="chat-input"
                                 Text="{Binding PromptText, Mode=TwoWay}"
                                 Watermark="Ask anything..."
                                 FontSize="13"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="False"
                                 MinHeight="{Binding IsInputExpanded, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=True, FallbackValue=26}"
                                 MaxHeight="140"
                                 Padding="14,6,38,6"
                                 VerticalContentAlignment="Center"
                                 GotFocus="OnTextBoxGotFocus"
                                 LostFocus="OnTextBoxLostFocus"
                                 KeyDown="OnTextBoxKeyDown"/>

                        <!-- Collapsed Action Panel (Right-aligned in collapsed mode) -->
                        <Panel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                               IsVisible="{Binding !IsInputExpanded}">
                            <Button Command="{Binding StopCommand}"
                                    Width="26" Height="26" CornerRadius="13"
                                    Background="#18181B" Foreground="#FFFFFF"
                                    Padding="0" Cursor="Hand"
                                    IsVisible="{Binding IsBusy}"
                                    ToolTip.Tip="Stop">
                                <Border Width="8" Height="8" Background="#FFFFFF" CornerRadius="1.5"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Command="{Binding SendCommand}"
                                    Width="26" Height="26" CornerRadius="13"
                                    Background="#18181B" Foreground="#FFFFFF"
                                    Padding="0" Cursor="Hand"
                                    IsVisible="{Binding HasTextToSend}"
                                    ToolTip.Tip="Send prompt (Enter)">
                                <PathIcon Width="12" Height="12" Foreground="#FFFFFF"
                                          Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"
                                          Margin="1,0,0,0"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Command="{Binding ToggleVoiceRecordingCommand}"
                                    Width="26" Height="26" CornerRadius="13"
                                    Background="#18181B" Foreground="#FFFFFF"
                                    Padding="0" Cursor="Hand"
                                    IsVisible="{Binding ShowMicButton}"
                                    ToolTip.Tip="Voice prompt">
                                <TextBlock Text="🎙️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Panel>
                    </Grid>

                    <!-- Bottom toolbar — ONLY visible when expanded (OpenAI flower logo removed) -->
                    <Grid Grid.Row="1"
                          ColumnDefinitions="Auto,*,Auto,Auto"
                          Margin="10,0,8,6"
                          IsVisible="{Binding IsInputExpanded}">

                        <!-- "+" attach button (left) -->
                        <Button Grid.Column="0" Click="OnAddAttachmentClick"
                                Width="26" Height="26" CornerRadius="6"
                                Background="Transparent" BorderThickness="0"
                                Padding="0" Margin="0,0,4,0" Cursor="Hand" ToolTip.Tip="Attach files or images (max 6)">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                     <Setter Property="Background" Value="#ECECE8"/>
                                </Style>
                            </Button.Styles>
                            <TextBlock Text="+" FontSize="16" Foreground="#71717A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Middle Spacer -->
                        <Panel Grid.Column="1"/>

                        <!-- Effort Button -->
                        <Button Grid.Column="2" Command="{Binding CycleEffortCommand}"
                                Background="Transparent" BorderThickness="0" CornerRadius="6"
                                Width="26" Height="26" Padding="0" Margin="0,0,6,0" Cursor="Hand"
                                ToolTip.Tip="{Binding EffortLevel}">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#ECECE8"/>
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="2.5" Height="6" Background="#71717A" CornerRadius="1"/>
                                <Border Width="2.5" Height="9" Background="#71717A" CornerRadius="1"
                                        IsVisible="{Binding EffortLevel, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter='Low'}"/>
                                <Border Width="2.5" Height="9" Background="#D4D4D8" CornerRadius="1"
                                        IsVisible="{Binding EffortLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Low'}"/>
                                <Border Width="2.5" Height="12" Background="#71717A" CornerRadius="1"
                                        IsVisible="{Binding EffortLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Max Effort'}"/>
                                <Border Width="2.5" Height="12" Background="#D4D4D8" CornerRadius="1"
                                        IsVisible="{Binding EffortLevel, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter='Max Effort'}"/>
                            </StackPanel>
                        </Button>

                        <!-- Send/Stop/Mic circular button (Airplane SVG) -->
                        <Panel Grid.Column="3" VerticalAlignment="Center">
                            <Button Command="{Binding StopCommand}"
                                    Width="28" Height="28" CornerRadius="14"
                                    Background="#18181B" Foreground="#FFFFFF" Padding="0" Cursor="Hand"
                                    IsVisible="{Binding IsBusy}" ToolTip.Tip="Stop">
                                <Border Width="9" Height="9" Background="#FFFFFF" CornerRadius="2"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Command="{Binding SendCommand}"
                                    Width="28" Height="28" CornerRadius="14"
                                    Background="#18181B" Foreground="#FFFFFF" Padding="0" Cursor="Hand"
                                    IsVisible="{Binding HasTextToSend}" ToolTip.Tip="Send prompt (Enter)">
                                <PathIcon Width="13" Height="13" Foreground="#FFFFFF"
                                          Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"
                                          Margin="1,0,0,0"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Command="{Binding ToggleVoiceRecordingCommand}"
                                    Width="28" Height="28" CornerRadius="14"
                                    Background="#18181B" Foreground="#FFFFFF" Padding="0" Cursor="Hand"
                                    IsVisible="{Binding ShowMicButton}" ToolTip.Tip="Voice prompt">
                                <TextBlock Text="🎙️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Panel>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
