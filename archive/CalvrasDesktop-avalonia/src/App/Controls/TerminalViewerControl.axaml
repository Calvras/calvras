<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Calvras.Core.Models"
             x:Class="Calvras.App.Controls.TerminalViewerControl"
             x:DataType="m:TraceNodeModel">

    <Border Background="#0C0C0E" BorderBrush="#222226" BorderThickness="1" CornerRadius="8" Margin="0,3,0,3" ClipToBounds="True">
        <StackPanel Spacing="0">
            <!-- Terminal Command Header -->
            <Border Background="#141417" BorderBrush="#222226" BorderThickness="0,0,0,1" Padding="10,6">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                    <!-- Violet Terminal Icon -->
                    <PathIcon Grid.Column="0" Width="13" Height="13" Foreground="#8B5CF6"
                              Data="M2 4a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4zm2 0v16h16V4H4zm3 4l4 4-4 4-1.41-1.41L6.17 12l-2.58-2.59L5 8zm6 7h6v2h-6v-2z"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>

                    <!-- Prompt symbol -->
                    <TextBlock Grid.Column="1" Text="$" Foreground="#71717A" FontWeight="Bold"
                               FontFamily="Consolas, Monaco, Monospace" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>

                    <!-- Command text -->
                    <TextBlock Grid.Column="2" Text="{Binding Command}" Foreground="#F4F4F5"
                               FontFamily="Consolas, Monaco, Monospace" FontSize="11" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                    <!-- Duration in ms -->
                    <TextBlock Grid.Column="3"
                               Text="{Binding DurationMs, StringFormat='{}{0}ms'}"
                               Foreground="#71717A" FontFamily="Consolas, Monaco, Monospace" FontSize="10.5"
                               VerticalAlignment="Center" Margin="10,0,8,0"
                               IsVisible="{Binding DurationMs, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                    <!-- Exit code badge -->
                    <Border Grid.Column="4" Name="ExitBadge" CornerRadius="4" Padding="6,1.5" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Name="ExitText"
                                   Text="{Binding ExitCode, StringFormat='{}exit {0}'}"
                                   FontSize="10" FontWeight="SemiBold"
                                   FontFamily="Consolas, Monaco, Monospace"/>
                    </Border>

                    <!-- Copy button with checkmark feedback -->
                    <Button Grid.Column="5" Name="CopyButton" Click="OnCopyClick"
                            Background="Transparent" BorderThickness="0" Padding="4,2" CornerRadius="4" Cursor="Hand"
                            ToolTip.Tip="Copy command and output">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#222226"/>
                            </Style>
                        </Button.Styles>
                        <Panel>
                            <PathIcon Name="CopyIcon" Width="12" Height="12" Foreground="#71717A"
                                      Data="M4,2 C2.8954305,2 2,2.8954305 2,4 L2,14 C2,15.1045695 2.8954305,16 4,16 L12,16 C13.1045695,16 14,15.1045695 14,14 L14,4 C14,2.8954305 13.1045695,2 12,2 L4,2 Z M4,3 L12,3 C12.5522847,3 13,3.44771525 13,4 L13,14 C13,14.5522847 12.5522847,15 12,15 L4,15 C3.44771525,15 3,14.5522847 3,14 L3,4 C3,3.44771525 3.44771525,3 4,3 Z"/>
                            <TextBlock Name="CopiedIcon" Text="✓" FontSize="11" FontWeight="Bold" Foreground="#10B981" IsVisible="False"/>
                        </Panel>
                    </Button>
                </Grid>
            </Border>

            <!-- Output body with colorized lines -->
            <Border Padding="10,8" MaxHeight="240"
                    IsVisible="{Binding Output, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="OutputLinesPanel" Spacing="1"/>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
