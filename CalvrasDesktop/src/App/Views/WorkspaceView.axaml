<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Calvras.App.ViewModels"
             xmlns:m="using:Calvras.Core.Models"
             xmlns:c="using:Calvras.App.Controls"
             x:Class="Calvras.App.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel"
             Background="#121212">

    <Grid ColumnDefinitions="*,Auto">
        <!-- Main Workspace Area with strict 25px vertical clearance between messages and input -->
        <Grid Grid.Column="0" RowDefinitions="*,Auto">
            <!-- Scrollable Timeline fills space above, guaranteed 25px above the input -->
            <ScrollViewer Grid.Row="0" Name="TimelineScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="20,20,20,0" Margin="0,0,0,25">
                <StackPanel MaxWidth="680" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                    <!-- Welcome state (calvras.com: logo + text centered, no starter pills) -->
                    <StackPanel IsVisible="{Binding !Messages.Count}" Margin="0,180,0,0" HorizontalAlignment="Center">
                        <Image Source="/Assets/calvras-logo.png" Width="56" Height="56"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapInterpolationMode="HighQuality"
                               Margin="0,0,0,20"/>
                        <TextBlock Text="Your next idea starts here." FontSize="24" FontWeight="Normal"
                                   Foreground="#F4F4F5" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Chat Message List -->
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:ChatMessageModel">
                                <StackPanel Margin="0,8">
                                    <!-- User Message (ONLY visible when IsUser, right-aligned) -->
                                    <Border IsVisible="{Binding IsUser}"
                                            HorizontalAlignment="Right" Background="#242426" CornerRadius="18"
                                            Padding="16,10" MaxWidth="540" Margin="0,4">
                                        <StackPanel Spacing="4">
                                            <SelectableTextBlock Text="{Binding Text}" Foreground="#FFFFFF"
                                                                 FontSize="13.5" TextWrapping="Wrap" LineHeight="20"/>
                                            <ItemsControl ItemsSource="{Binding AttachedFiles}" IsVisible="{Binding HasAttachedFiles}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1C1C1F" CornerRadius="4" Padding="6,2" Margin="0,2">
                                                            <TextBlock Text="{Binding}" Foreground="#8E8E93" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Assistant Message (ONLY visible when IsAssistant, left-aligned) -->
                                    <StackPanel IsVisible="{Binding IsAssistant}" HorizontalAlignment="Left" MaxWidth="680" Margin="0,4,0,8" Spacing="8">
                                        <!-- Unified Work Trace with Master Header (ported from ai-agent-response.tsx) -->
                                        <c:AgentActivityControl
                                            Phases="{Binding Phases}"
                                            IsWorking="{Binding !Done}"
                                            ElapsedSeconds="{Binding ElapsedSeconds}"/>

                                        <!-- Final streaming / typed Markdown response -->
                                        <c:MarkdownTextControl Text="{Binding Text}" IsVisible="{Binding HasText}"/>

                                        <!-- Assistant Response Action Bar (Copy, Thumbs Up, Thumbs Down) -->
                                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0" IsVisible="{Binding HasText}">
                                            <!-- Copy SVG Button -->
                                            <Button Command="{Binding $parent[UserControl].DataContext.CopyMessageCommand}"
                                                    CommandParameter="{Binding Text}"
                                                    Background="Transparent" BorderThickness="0" Padding="6,4" CornerRadius="6" Cursor="Hand"
                                                    ToolTip.Tip="Copy response">
                                                <Button.Styles>
                                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="#27272A"/>
                                                    </Style>
                                                </Button.Styles>
                                                <PathIcon Width="13" Height="13" Foreground="#71717A"
                                                          Data="M4,2 C2.8954305,2 2,2.8954305 2,4 L2,14 C2,15.1045695 2.8954305,16 4,16 L12,16 C13.1045695,16 14,15.1045695 14,14 L14,4 C14,2.8954305 13.1045695,2 12,2 L4,2 Z M4,3 L12,3 C12.5522847,3 13,3.44771525 13,4 L13,14 C13,14.5522847 12.5522847,15 12,15 L4,15 C3.44771525,15 3,14.5522847 3,14 L3,4 C3,3.44771525 3.44771525,3 4,3 Z"/>
                                            </Button>

                                            <!-- Thumbs Up SVG Button -->
                                            <Button Command="{Binding $parent[UserControl].DataContext.FeedbackUpCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Padding="6,4" CornerRadius="6" Cursor="Hand"
                                                    ToolTip.Tip="Good response">
                                                <Button.Styles>
                                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="#27272A"/>
                                                    </Style>
                                                </Button.Styles>
                                                <PathIcon Width="13" Height="13" Foreground="#71717A"
                                                          Data="M2 10h3v10H2zm18-1c0-.55-.45-1-1-1h-6.31l.95-4.57.03-.32c0-.41-.17-.79-.44-1.06L12.17 2 7.58 6.59C7.22 6.95 7 7.45 7 8v10c0 1.1.9 2 2 2h9c.83 0 1.54-.5 1.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73v-2z"/>
                                            </Button>

                                            <!-- Thumbs Down SVG Button -->
                                            <Button Command="{Binding $parent[UserControl].DataContext.FeedbackDownCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Padding="6,4" CornerRadius="6" Cursor="Hand"
                                                    ToolTip.Tip="Bad response">
                                                <Button.Styles>
                                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="#27272A"/>
                                                    </Style>
                                                </Button.Styles>
                                                <PathIcon Width="13" Height="13" Foreground="#71717A"
                                                          Data="M19 14h3V4h-3zM2 15c0 .55.45 1 1 1h6.31l-.95 4.57-.03.32c0 .41.17.79.44 1.06L9.83 22l4.59-4.59c.36-.36.58-.86.58-1.41V6c0-1.1-.9-2-2-2H4c-.83 0-1.54.5-1.84 1.22l-3.02 7.05c-.09.23-.14.47-.14.73v2z"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- Error banner if failed -->
                                        <Border Background="#1C1C1F" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8"
                                                Padding="10,6" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="{Binding Error}" Foreground="#EF4444" FontSize="12" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Input seated in bottom row, strictly separated from messages by 25px -->
            <Border Grid.Row="1" Background="#121212" Padding="20,0,20,18" HorizontalAlignment="Stretch">
                <c:PromptInput DataContext="{Binding}" HorizontalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- Implementation Plan Side Drawer (Only opens on explicit toggle) -->
        <Border Grid.Column="1" Width="360" Background="#141416" BorderBrush="#1E1E22" BorderThickness="1,0,0,0" IsVisible="{Binding IsPlanOpen}">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" BorderBrush="#1E1E22" BorderThickness="0,0,0,1" Padding="16,14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="📋" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ActivePlan.Title, FallbackValue='Implementation Plan'}" FontWeight="Bold" FontSize="13" Foreground="#F4F4F5" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding TogglePlanCommand}" Background="Transparent" BorderThickness="0" Foreground="#71717A" Content="✕" Cursor="Hand"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" Padding="16">
                    <SelectableTextBlock Text="{Binding ActivePlan.Content}" Foreground="#A1A1AA" FontSize="12" FontFamily="Consolas, Monaco, Monospace" TextWrapping="Wrap" LineHeight="19"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
