<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Calvras.App.ViewModels"
        xmlns:m="using:Calvras.Core.Models"
        x:Class="Calvras.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/calvras-logo.ico"
        Title="Calvras"
        Width="1260" Height="840" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        DragDrop.AllowDrop="True">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding CreateNewProjectCommand}"/>
    </Window.KeyBindings>

    <Grid RowDefinitions="48,*">
        <!-- Minimal Top Header Bar (Matching design) -->
        <Border Grid.Row="0" Background="#121212" BorderThickness="0" Padding="12,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: Sidebar Toggle + Native Menu (Calvras, File, View, Window) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleSidebarCommand}" Background="Transparent" BorderThickness="0"
                            Padding="6" CornerRadius="6" Cursor="Hand" ToolTip.Tip="Toggle Navigation Sidebar">
                        <!-- Custom Sidebar Column Icon [|] -->
                        <Border Width="18" Height="15" BorderBrush="#6B6B6B" BorderThickness="1.5" CornerRadius="3">
                            <Border Width="1.5" Background="#6B6B6B" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Border>
                    </Button>

                    <!-- Native Application Menu -->
                    <Menu Background="Transparent" VerticalAlignment="Center">
                        <!-- Calvras Menu -->
                        <MenuItem Header="Calvras" Foreground="#D4D4D8" FontSize="12">
                            <MenuItem Header="Version 1.0.4" IsEnabled="False"/>
                            <Separator/>
                            <MenuItem Header="Check for Updates..." Command="{Binding ApplyUpdateCommand}"/>
                            <MenuItem Header="Documentation &amp; Community" Click="OnOpenWebsiteClick"/>
                            <Separator/>
                            <MenuItem Header="Exit Calvras" Click="OnExitClick"/>
                        </MenuItem>

                        <!-- File Menu -->
                        <MenuItem Header="File" Foreground="#D4D4D8" FontSize="12">
                            <MenuItem Header="New Conversation" Command="{Binding CreateNewProjectCommand}" InputGesture="Ctrl+N"/>
                            <MenuItem Header="Open Folder..." Click="OnOpenFolderClick" InputGesture="Ctrl+O"/>
                            <Separator/>
                            <MenuItem Header="Close Window" Click="OnExitClick"/>
                        </MenuItem>

                        <!-- View Menu -->
                        <MenuItem Header="View" Foreground="#D4D4D8" FontSize="12">
                            <MenuItem Header="Toggle Sidebar" Command="{Binding ToggleSidebarCommand}" InputGesture="Ctrl+B"/>
                            <Separator/>
                            <MenuItem Header="Toggle Dark / Light Mode" Command="{Binding ToggleThemeCommand}"/>
                        </MenuItem>

                        <!-- Window Menu -->
                        <MenuItem Header="Window" Foreground="#D4D4D8" FontSize="12">
                            <MenuItem Header="Minimize" Click="OnMinimizeClick"/>
                            <MenuItem Header="Close" Click="OnExitClick"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <!-- Center: Empty spacing (no digital clock) -->
                <Panel Grid.Column="1"/>

                <!-- Right: Update Button (Only when update is available) & Open project badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Update Button (ONLY visible when an update is available, grey background with 'Update' text, no purple icon) -->
                    <Button Command="{Binding ApplyUpdateCommand}"
                            Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1"
                            CornerRadius="8" Padding="12,5" Cursor="Hand"
                            IsVisible="{Binding HasUpdateAvailable}"
                            ToolTip.Tip="A new update is available. Click to install.">
                        <TextBlock Text="Update" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Active Project / Open project Button (with SVG folder icon) -->
                    <Button Click="OnOpenFolderClick"
                            Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1"
                            CornerRadius="8" Padding="10,5" Cursor="Hand"
                            ToolTip.Tip="Open project folder">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#222222"/>
                            </Style>
                        </Button.Styles>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- SVG Folder Icon -->
                            <PathIcon Width="12" Height="12" Foreground="#9CA3AF"
                                      Data="M1.5 4.5C1.5 3.67 2.17 3 3 3h2.38c.28 0 .55.1.74.3l.88.88H11c.83 0 1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5H3c-.83 0-1.5-.67-1.5-1.5v-6Z"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveProject.Name, FallbackValue='Open project'}"
                                       FontSize="11.5" FontWeight="Medium" Foreground="#D4D4D8"
                                       VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Collapsible Sidebar + Active Content View -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <!-- Left Collapsible Sidebar (Matching calvras.com screenshots) -->
            <Border Grid.Column="0" Width="228" Background="#171717"
                    BorderBrush="#1E1E1E" BorderThickness="0,0,1,0"
                    IsVisible="{Binding IsSidebarOpen}">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Top Section: Logo Header + New Chat + Navigation -->
                    <StackPanel Grid.Row="0" Spacing="2" Margin="10,12,10,0">

                        <!-- Logo + Calvras Name + Chevron + Search + Bell -->
                        <Grid ColumnDefinitions="*,Auto" Margin="4,0,0,10">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Image Source="/Assets/calvras-logo.png" Width="18" Height="18" VerticalAlignment="Center"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                <TextBlock Text="Calvras" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="#F4F4F5" VerticalAlignment="Center"/>
                                <TextBlock Text="⌄" FontSize="10" Foreground="#71717A" VerticalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Background="Transparent" BorderThickness="0" Padding="4" CornerRadius="5" Cursor="Hand" ToolTip.Tip="Search">
                                    <TextBlock Text="⌕" FontSize="13" Foreground="#71717A"/>
                                </Button>
                                <Button Background="Transparent" BorderThickness="0" Padding="4" CornerRadius="5" Cursor="Hand" ToolTip.Tip="Notifications">
                                    <TextBlock Text="🔔" FontSize="12" Foreground="#71717A"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- "New chat" button -->
                        <Button Command="{Binding CreateNewProjectCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="#222222" BorderBrush="#2E2E2E" BorderThickness="1"
                                CornerRadius="8" Padding="10,8" Cursor="Hand" Margin="0,0,0,4">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#2A2A2A"/>
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="✎" FontSize="13" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                                <TextBlock Text="New chat" FontSize="12.5" FontWeight="Medium"
                                           Foreground="#F4F4F5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Plugins -->
                        <Button Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="10,7" CornerRadius="6" Cursor="Hand">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#1F1F1F"/>
                                </Style>
                            </Button.Styles>
                            <TextBlock Text="Plugins" FontSize="12.5" Foreground="#8E8E93"/>
                        </Button>

                        <!-- Sign up -->
                        <Button Command="{Binding NavigateToCommand}" CommandParameter="SignIn"
                                Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="10,7" CornerRadius="6" Cursor="Hand">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#1F1F1F"/>
                                </Style>
                            </Button.Styles>
                            <TextBlock Text="Sign up" FontSize="12.5" Foreground="#8E8E93"/>
                        </Button>
                    </StackPanel>

                    <!-- Middle: Projects + Recents -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10,8,10,0">
                        <StackPanel Spacing="0">
                            <!-- Projects section header -->
                            <Grid ColumnDefinitions="*,Auto" Margin="4,8,4,4">
                                <TextBlock Grid.Column="0" Text="Projects" FontSize="11"
                                           FontWeight="SemiBold" Foreground="#555555" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="›" FontSize="12" Foreground="#555555" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Project List -->
                            <ItemsControl ItemsSource="{Binding RecentProjects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:ProjectModel">
                                        <Button Click="OnProjectItemClick" Tag="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Padding="8,6" CornerRadius="6" Margin="0,1" Cursor="Hand">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="#1F1F1F"/>
                                                </Style>
                                            </Button.Styles>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="▸" FontSize="10" Foreground="#555555" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#D4D4D4"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Recents section header -->
                            <Grid ColumnDefinitions="*,Auto" Margin="4,16,4,4">
                                <TextBlock Grid.Column="0" Text="Recents" FontSize="11"
                                           FontWeight="SemiBold" Foreground="#555555" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="No recent chats" FontSize="11.5" Foreground="#3A3A3A"
                                       Margin="8,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom: View Usage + User Account -->
                    <Border Grid.Row="2" BorderBrush="#1E1E1E" BorderThickness="0,1,0,0" Padding="10,10,10,10">
                        <StackPanel Spacing="2">
                            <!-- View Usage -->
                            <Button Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Padding="6,6" CornerRadius="6" Cursor="Hand">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#1F1F1F"/>
                                    </Style>
                                </Button.Styles>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="View Usage" FontSize="12" Foreground="#8E8E93"/>
                                    <TextBlock Text="↗" FontSize="10" Foreground="#555555" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Settings Button (Image 5 spec) -->
                            <Button Command="{Binding ToggleSettingsCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Padding="6,7" CornerRadius="8" Cursor="Hand">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#1F1F1F"/>
                                    </Style>
                                </Button.Styles>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <PathIcon Width="14" Height="14" Foreground="#8E8E93"
                                              Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                                    <TextBlock Text="Settings" FontSize="12.5" FontWeight="Medium" Foreground="#D4D4D8" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Active View Content Host -->
            <Grid Grid.Column="1" Background="#121212">
                <ContentControl Content="{Binding CurrentView}"/>
            </Grid>

            <!-- Settings Modal Popup Overlay -->
            <Border Grid.Column="0" Grid.ColumnSpan="2"
                    Background="#8A000000"
                    IsVisible="{Binding IsSettingsOpen}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border Width="560" MaxHeight="480"
                        Background="#18181B" BorderBrush="#2E2E33" BorderThickness="1"
                        CornerRadius="16" BoxShadow="0 20 60 #90000000"
                        Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Header -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <PathIcon Width="18" Height="18" Foreground="#A1A1AA"
                                          Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                                <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding CloseSettingsCommand}"
                                    Width="28" Height="28" CornerRadius="14"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="0" Cursor="Hand">
                                <TextBlock Text="✕" FontSize="13" Foreground="#71717A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <!-- Content Tabs / Sections -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16">
                                <!-- AI Model Settings -->
                                <Border Background="#202024" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Padding="14">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="AI Engine" FontSize="13" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Default AI Model" FontSize="12" Foreground="#D4D4D8"/>
                                                <TextBlock Text="Used for autonomous code generation and problem solving" FontSize="10.5" Foreground="#71717A"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" SelectedIndex="0" Width="160" Background="#18181B" BorderBrush="#323238">
                                                <ComboBoxItem Content="GPT 5.5"/>
                                                <ComboBoxItem Content="Opus 4.8"/>
                                                <ComboBoxItem Content="Gemini 3.5 Flash"/>
                                                <ComboBoxItem Content="Composer 2.5"/>
                                                <ComboBoxItem Content="GLM 5.2"/>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Editor / General Settings -->
                                <Border Background="#202024" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Padding="14">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="General" FontSize="13" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Theme" FontSize="12" Foreground="#D4D4D8"/>
                                                <TextBlock Text="Dark theme optimized for OLED and low light" FontSize="10.5" Foreground="#71717A"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" SelectedIndex="0" Width="160" Background="#18181B" BorderBrush="#323238">
                                                <ComboBoxItem Content="Calvras Dark"/>
                                                <ComboBoxItem Content="System Default"/>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- About & Updates -->
                                <Border Background="#202024" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Padding="14">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="About &amp; Updates" FontSize="13" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Calvras Desktop v1.0.4" FontSize="12" Foreground="#D4D4D8"/>
                                                <TextBlock Text="Connected to Calvras Cloud AI" FontSize="10.5" Foreground="#71717A"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Command="{Binding ApplyUpdateCommand}"
                                                    Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1"
                                                    CornerRadius="6" Padding="10,5" Cursor="Hand">
                                                <TextBlock Text="Check for Updates" FontSize="11" Foreground="#FFFFFF"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
