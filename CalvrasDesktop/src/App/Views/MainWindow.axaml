<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Calvras.App.ViewModels"
        xmlns:m="using:Calvras.Core.Models"
        x:Class="Calvras.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/calvras-logo.ico"
        Title="Calvras"
        Width="1260" Height="840" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        DragDrop.AllowDrop="True">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding CreateNewProjectCommand}"/>
    </Window.KeyBindings>

    <Grid RowDefinitions="48,*">
        <!-- Minimal Top Header Bar (Matching calvras.com) -->
        <Border Grid.Row="0" Background="#121212" BorderBrush="#1E1E1E" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: Sidebar Toggle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleSidebarCommand}" Background="Transparent" BorderThickness="0"
                            Padding="6" CornerRadius="6" Cursor="Hand" ToolTip.Tip="Toggle Navigation Sidebar">
                        <!-- Custom Sidebar Column Icon [|] -->
                        <Border Width="18" Height="15" BorderBrush="#6B6B6B" BorderThickness="1.5" CornerRadius="3">
                            <Border Width="1.5" Background="#6B6B6B" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Border>
                    </Button>
                </StackPanel>

                <!-- Center: Live Digital Clock -->
                <TextBlock Grid.Column="1" Text="{Binding ClockTime}"
                           Foreground="#71717A" FontFamily="Consolas, Monaco, Monospace"
                           FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Right: Update Button (Only when update is available) & Open project badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Update Button (ONLY visible when an update is available, grey background with 'Update' text) -->
                    <Button Command="{Binding ApplyUpdateCommand}"
                            Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1"
                            CornerRadius="8" Padding="12,5" Cursor="Hand"
                            IsVisible="{Binding HasUpdateAvailable}"
                            ToolTip.Tip="A new update is available. Click to install.">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="✦" FontSize="11" Foreground="#A855F7" VerticalAlignment="Center"/>
                            <TextBlock Text="Update" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Active Project / Open project Button (Matches calvras.com) -->
                    <Button Click="OnOpenFolderClick"
                            Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1"
                            CornerRadius="8" Padding="10,5" Cursor="Hand"
                            ToolTip.Tip="Open project folder">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#222222"/>
                            </Style>
                        </Button.Styles>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- Minimal folder SVG style path -->
                            <TextBlock Text="📁" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveProject.Name, FallbackValue='Open project'}"
                                       FontSize="11.5" FontWeight="Medium" Foreground="#D4D4D8"
                                       VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Collapsible Sidebar + Active Content View -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <!-- Left Collapsible Sidebar (Matching calvras.com screenshots) -->
            <Border Grid.Column="0" Width="228" Background="#171717"
                    BorderBrush="#1E1E1E" BorderThickness="0,0,1,0"
                    IsVisible="{Binding IsSidebarOpen}">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Top Section: Logo Header + New Chat + Navigation -->
                    <StackPanel Grid.Row="0" Spacing="2" Margin="10,12,10,0">

                        <!-- Logo + Calvras Name + Chevron + Search + Bell -->
                        <Grid ColumnDefinitions="*,Auto" Margin="4,0,0,10">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Image Source="/Assets/calvras-logo.png" Width="18" Height="18" VerticalAlignment="Center"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                <TextBlock Text="Calvras" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="#F4F4F5" VerticalAlignment="Center"/>
                                <TextBlock Text="⌄" FontSize="10" Foreground="#71717A" VerticalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Background="Transparent" BorderThickness="0" Padding="4" CornerRadius="5" Cursor="Hand" ToolTip.Tip="Search">
                                    <TextBlock Text="⌕" FontSize="13" Foreground="#71717A"/>
                                </Button>
                                <Button Background="Transparent" BorderThickness="0" Padding="4" CornerRadius="5" Cursor="Hand" ToolTip.Tip="Notifications">
                                    <TextBlock Text="🔔" FontSize="12" Foreground="#71717A"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- "New chat" button -->
                        <Button Command="{Binding CreateNewProjectCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="#222222" BorderBrush="#2E2E2E" BorderThickness="1"
                                CornerRadius="8" Padding="10,8" Cursor="Hand" Margin="0,0,0,4">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#2A2A2A"/>
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="✎" FontSize="13" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                                <TextBlock Text="New chat" FontSize="12.5" FontWeight="Medium"
                                           Foreground="#F4F4F5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Plugins -->
                        <Button Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="10,7" CornerRadius="6" Cursor="Hand">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#1F1F1F"/>
                                </Style>
                            </Button.Styles>
                            <TextBlock Text="Plugins" FontSize="12.5" Foreground="#8E8E93"/>
                        </Button>

                        <!-- Sign up -->
                        <Button Command="{Binding NavigateToCommand}" CommandParameter="SignIn"
                                Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="10,7" CornerRadius="6" Cursor="Hand">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#1F1F1F"/>
                                </Style>
                            </Button.Styles>
                            <TextBlock Text="Sign up" FontSize="12.5" Foreground="#8E8E93"/>
                        </Button>
                    </StackPanel>

                    <!-- Middle: Projects + Recents -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10,8,10,0">
                        <StackPanel Spacing="0">
                            <!-- Projects section header -->
                            <Grid ColumnDefinitions="*,Auto" Margin="4,8,4,4">
                                <TextBlock Grid.Column="0" Text="Projects" FontSize="11"
                                           FontWeight="SemiBold" Foreground="#555555" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="›" FontSize="12" Foreground="#555555" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Project List -->
                            <ItemsControl ItemsSource="{Binding RecentProjects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:ProjectModel">
                                        <Button Click="OnProjectItemClick" Tag="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Padding="8,6" CornerRadius="6" Margin="0,1" Cursor="Hand">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="#1F1F1F"/>
                                                </Style>
                                            </Button.Styles>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="▸" FontSize="10" Foreground="#555555" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#D4D4D4"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Recents section header -->
                            <Grid ColumnDefinitions="*,Auto" Margin="4,16,4,4">
                                <TextBlock Grid.Column="0" Text="Recents" FontSize="11"
                                           FontWeight="SemiBold" Foreground="#555555" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="No recent chats" FontSize="11.5" Foreground="#3A3A3A"
                                       Margin="8,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom: View Usage + User Account -->
                    <Border Grid.Row="2" BorderBrush="#1E1E1E" BorderThickness="0,1,0,0" Padding="10,10,10,10">
                        <StackPanel Spacing="2">
                            <!-- View Usage -->
                            <Button Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Padding="6,6" CornerRadius="6" Cursor="Hand">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#1F1F1F"/>
                                    </Style>
                                </Button.Styles>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="View Usage" FontSize="12" Foreground="#8E8E93"/>
                                    <TextBlock Text="↗" FontSize="10" Foreground="#555555" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- User row -->
                            <Button Command="{Binding NavigateToCommand}" CommandParameter="SignIn"
                                    Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Padding="6,6" CornerRadius="6" Cursor="Hand">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#1F1F1F"/>
                                    </Style>
                                </Button.Styles>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Avatar circle -->
                                    <Border Grid.Column="0" Background="#2A2A2A" CornerRadius="12"
                                            Width="28" Height="28" VerticalAlignment="Center">
                                        <TextBlock Text="U" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#A1A1AA" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Name + plan -->
                                    <StackPanel Grid.Column="1" Spacing="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UserEmail, FallbackValue='User'}"
                                                   FontSize="11.5" FontWeight="Medium" Foreground="#D4D4D4"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Free plan" FontSize="10" Foreground="#555555"/>
                                    </StackPanel>
                                    <!-- Ellipsis -->
                                    <TextBlock Grid.Column="2" Text="···" FontSize="13"
                                               Foreground="#555555" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Active View Content Host -->
            <Grid Grid.Column="1" Background="#121212">
                <ContentControl Content="{Binding CurrentView}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
