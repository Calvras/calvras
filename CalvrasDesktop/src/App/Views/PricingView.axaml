<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Calvras.App.ViewModels"
             x:Class="Calvras.App.Views.PricingView"
             x:DataType="vm:PricingViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="880" Margin="32,36" Spacing="24">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="Simple, Transparent Pricing" FontSize="26" FontWeight="Bold" Foreground="#F0F6FC" TextAlignment="Center"/>
                <TextBlock Text="Choose the plan that suits your autonomous engineering needs." FontSize="13" Foreground="#8B949E" TextAlignment="Center"/>

                <!-- Annual Discount Toggle -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <TextBlock Text="Monthly" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                    <ToggleSwitch IsChecked="{Binding IsAnnual, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                    <TextBlock Text="Yearly (Save 20%)" FontSize="12" Foreground="#3FB950" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Tiers Grid -->
            <ItemsControl ItemsSource="{Binding Tiers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PricingTier">
                        <Border Background="#161B22" BorderBrush="{Binding IsPopular, Converter={x:Null}}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="8">
                            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                                <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="#F0F6FC"/>
                                <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11" Foreground="#8B949E" Margin="0,4,0,12" TextWrapping="Wrap"/>

                                <!-- Price -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding PriceYearly}" FontSize="28" FontWeight="Bold" Foreground="#F0F6FC"/>
                                    <TextBlock Text="/mo" FontSize="12" Foreground="#8B949E" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                </StackPanel>

                                <!-- Features list -->
                                <ItemsControl Grid.Row="3" ItemsSource="{Binding Features}" Margin="0,0,0,16">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3">
                                                <TextBlock Text="✓" Foreground="#3FB950" FontSize="12"/>
                                                <TextBlock Text="{Binding}" Foreground="#C9D1D9" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Grid.Row="4" Content="Select Plan" Click="OnSelectPlanClick" Tag="{Binding Name}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#21262D" BorderBrush="#30363D" Foreground="#F0F6FC" CornerRadius="8" Padding="12,8" Cursor="Hand"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
