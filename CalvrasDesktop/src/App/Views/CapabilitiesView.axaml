<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Calvras.App.ViewModels"
             x:Class="Calvras.App.Views.CapabilitiesView"
             x:DataType="vm:CapabilitiesViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="880" Margin="32,36" Spacing="24">
            <StackPanel Spacing="8">
                <TextBlock Text="Autonomous Capabilities" FontSize="26" FontWeight="Bold" Foreground="#F0F6FC"/>
                <TextBlock Text="Calvras is equipped with multi-tool execution engines that perform end-to-end software engineering tasks." FontSize="13" Foreground="#8B949E"/>
            </StackPanel>

            <!-- Cards Grid -->
            <ItemsControl ItemsSource="{Binding Capabilities}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CapabilityCard">
                        <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10" Padding="18" Margin="8">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding IconText}" FontSize="18" FontWeight="Bold" Foreground="#A855F7"/>
                                    <Border Grid.Column="2" Background="#21262D" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="#D2A8FF" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="#F0F6FC"/>
                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#8B949E" LineHeight="18" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
