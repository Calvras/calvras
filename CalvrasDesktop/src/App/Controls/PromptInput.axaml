<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Calvras.App.ViewModels"
             x:Class="Calvras.App.Controls.PromptInput"
             x:DataType="vm:WorkspaceViewModel">

    <UserControl.Styles>
        <!-- Flat borderless TextBox without cyan/blue focus ring -->
        <Style Selector="TextBox.chat-input">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#3F3F46"/>
        </Style>
        <Style Selector="TextBox.chat-input /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.chat-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.chat-input:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Base Composer Border: Collapsed Size -->
        <Style Selector="Border.composer-box">
            <Setter Property="Width" Value="380"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Background" Value="#161618"/>
            <Setter Property="BorderBrush" Value="#2A2A2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow" Value="0 8 28 #40000000"/>
        </Style>

        <!-- Expanded Composer Border -->
        <Style Selector="Border.composer-box.expanded">
            <Setter Property="Width" Value="560"/>
            <Setter Property="MinHeight" Value="122"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Background" Value="#17171A"/>
            <Setter Property="BorderBrush" Value="#2E2E33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow" Value="0 12 36 #60000000"/>
        </Style>
    </UserControl.Styles>

    <Grid HorizontalAlignment="Center">
        <StackPanel Spacing="0" HorizontalAlignment="Center">

            <!-- 1. Attachments Drawer (Slides above composer) -->
            <Border Background="#161618" BorderBrush="#2A2A2E" BorderThickness="1,1,1,0"
                    CornerRadius="16,16,0,0" Padding="12,8" Margin="12,0,12,0"
                    IsVisible="{Binding AttachedFiles.Count}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding AttachedFiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="56" Height="56" CornerRadius="12" Background="#202024" BorderBrush="#323238" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                            <TextBlock Text="📄" FontSize="16" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding}" FontSize="8" Foreground="#A1A1AA" MaxWidth="46" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).RemoveAttachmentCommand}"
                                                CommandParameter="{Binding}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Width="18" Height="18" CornerRadius="9" Padding="0" Margin="2"
                                                Background="#3F3F46" Foreground="White" Cursor="Hand">
                                            <TextBlock Text="✕" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 2. Model Selector Popup Menu -->
            <Border IsVisible="{Binding IsModelPickerOpen}"
                    Background="#1E1E22" BorderBrush="#333338" BorderThickness="1"
                    CornerRadius="16" Padding="6" Margin="12,0,12,8"
                    BoxShadow="0 12 36 #80000000">
                <StackPanel Spacing="2">
                    <TextBlock Text="Select AI Model" FontSize="11" FontWeight="SemiBold" Foreground="#71717A" Margin="10,6,10,4"/>

                    <!-- GPT 5.5 -->
                    <Button Command="{Binding SelectModelCommand}" CommandParameter="GPT 5.5"
                            Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="10,7" CornerRadius="8" Cursor="Hand">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="⚡" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="GPT 5.5" FontSize="12.5" FontWeight="Medium" Foreground="#F4F4F5" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="✓" FontSize="12" Foreground="#3FB950" VerticalAlignment="Center"
                                       IsVisible="{Binding SelectedModel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='GPT 5.5'}"/>
                        </Grid>
                    </Button>

                    <!-- Opus 4.8 -->
                    <Button Command="{Binding SelectModelCommand}" CommandParameter="Opus 4.8"
                            Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="10,7" CornerRadius="8" Cursor="Hand">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="🧠" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Opus 4.8" FontSize="12.5" FontWeight="Medium" Foreground="#F4F4F5" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="✓" FontSize="12" Foreground="#3FB950" VerticalAlignment="Center"
                                       IsVisible="{Binding SelectedModel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Opus 4.8'}"/>
                        </Grid>
                    </Button>

                    <!-- Gemini 3.5 Flash -->
                    <Button Command="{Binding SelectModelCommand}" CommandParameter="Gemini 3.5 Flash"
                            Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="10,7" CornerRadius="8" Cursor="Hand">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="✨" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Gemini 3.5 Flash" FontSize="12.5" FontWeight="Medium" Foreground="#F4F4F5" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="✓" FontSize="12" Foreground="#3FB950" VerticalAlignment="Center"
                                       IsVisible="{Binding SelectedModel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Gemini 3.5 Flash'}"/>
                        </Grid>
                    </Button>

                    <!-- Composer 2.5 -->
                    <Button Command="{Binding SelectModelCommand}" CommandParameter="Composer 2.5"
                            Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="10,7" CornerRadius="8" Cursor="Hand">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="🛠️" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Composer 2.5" FontSize="12.5" FontWeight="Medium" Foreground="#F4F4F5" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="✓" FontSize="12" Foreground="#3FB950" VerticalAlignment="Center"
                                       IsVisible="{Binding SelectedModel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Composer 2.5'}"/>
                        </Grid>
                    </Button>

                    <!-- GLM 5.2 -->
                    <Button Command="{Binding SelectModelCommand}" CommandParameter="GLM 5.2"
                            Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="10,7" CornerRadius="8" Cursor="Hand">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="🌐" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="GLM 5.2" FontSize="12.5" FontWeight="Medium" Foreground="#F4F4F5" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="✓" FontSize="12" Foreground="#3FB950" VerticalAlignment="Center"
                                       IsVisible="{Binding SelectedModel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='GLM 5.2'}"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 3. Main Smooth Transition Composer Card -->
            <Border Name="ComposerBorder"
                    Classes="composer-box"
                    Classes.expanded="{Binding IsInputExpanded}"
                    PointerPressed="OnComposerPointerPressed">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Width" Duration="0:0:0.32" Easing="CubicEaseOut"/>
                        <DoubleTransition Property="MinHeight" Duration="0:0:0.32" Easing="CubicEaseOut"/>
                    </Transitions>
                </Border.Transitions>

                <Grid RowDefinitions="Auto,Auto">

                    <!-- Top Row: Textarea + Action Button in Collapsed Mode -->
                    <Grid Grid.Row="0" Margin="0,0,0,0">
                        <!-- Text Input -->
                        <TextBox Name="PromptTextBox"
                                 Classes="chat-input"
                                 Text="{Binding PromptText, Mode=TwoWay}"
                                 Watermark="Ask anything..."
                                 FontSize="13.5"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="{Binding IsInputExpanded, Converter={x:Null}}"
                                 MaxHeight="160"
                                 Padding="18,13,48,10"
                                 GotFocus="OnTextBoxGotFocus"
                                 LostFocus="OnTextBoxLostFocus">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SendCommand}"/>
                                <KeyBinding Gesture="Escape" Command="{Binding CollapseInputCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>

                        <!-- Collapsed Action Button (Right-aligned in collapsed mode) -->
                        <Button Grid.Column="0"
                                Command="{Binding ToggleVoiceRecordingCommand}"
                                Width="34" Height="34" CornerRadius="17"
                                Background="#E4E4E7" Foreground="#18181B"
                                Padding="0" Margin="0,0,7,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Cursor="Hand"
                                IsVisible="{Binding !IsInputExpanded}"
                                ToolTip.Tip="Voice prompt">
                            <TextBlock Text="🎙️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Bottom Controls Row: ONLY VISIBLE WHEN EXPANDED -->
                    <Grid Grid.Row="1"
                          ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                          Margin="14,4,12,10"
                          IsVisible="{Binding IsInputExpanded}">

                        <!-- Left: Model Pill -->
                        <Button Grid.Column="0" Command="{Binding ToggleModelPickerCommand}"
                                Background="Transparent" BorderThickness="0" CornerRadius="10"
                                Padding="6,4" Cursor="Hand" ToolTip.Tip="Select AI Model">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#26262B"/>
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="12" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedModel}" FontSize="11.5" FontWeight="Medium" Foreground="#D4D4D8" VerticalAlignment="Center"/>
                                <TextBlock Text="⌄" FontSize="9" Foreground="#71717A" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Left: Effort Button (3 dynamic vertical bars) -->
                        <Button Grid.Column="1" Command="{Binding CycleEffortCommand}"
                                Background="Transparent" BorderThickness="0" CornerRadius="10"
                                Padding="6,4" Margin="2,0,0,0" Cursor="Hand" ToolTip.Tip="Reasoning effort (Low / Medium / Max Effort)">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#26262B"/>
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2.5" VerticalAlignment="Center">
                                    <!-- Bar 1 (always on) -->
                                    <Border Width="2.5" Height="6" Background="#A1A1AA" CornerRadius="1"/>
                                    <!-- Bar 2 (Medium or Max) -->
                                    <Border Width="2.5" Height="9" Background="#A1A1AA" CornerRadius="1"
                                            IsVisible="{Binding EffortLevel, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter='Low'}"/>
                                    <Border Width="2.5" Height="9" Background="#3F3F46" CornerRadius="1"
                                            IsVisible="{Binding EffortLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Low'}"/>
                                    <!-- Bar 3 (Max Effort only) -->
                                    <Border Width="2.5" Height="13" Background="#A1A1AA" CornerRadius="1"
                                            IsVisible="{Binding EffortLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Max Effort'}"/>
                                    <Border Width="2.5" Height="13" Background="#3F3F46" CornerRadius="1"
                                            IsVisible="{Binding EffortLevel, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter='Max Effort'}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding EffortLevel}" FontSize="11.5" FontWeight="Medium" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Middle Spacer + Audio Waveform (When Recording) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                    IsVisible="{Binding IsRecording}">
                            <Border Width="3" Height="10" Background="#A1A1AA" CornerRadius="1.5"/>
                            <Border Width="3" Height="18" Background="#A1A1AA" CornerRadius="1.5"/>
                            <Border Width="3" Height="8" Background="#A1A1AA" CornerRadius="1.5"/>
                            <Border Width="3" Height="15" Background="#A1A1AA" CornerRadius="1.5"/>
                            <Border Width="3" Height="6" Background="#A1A1AA" CornerRadius="1.5"/>
                        </StackPanel>

                        <!-- Right: Add Attachment Button (+) -->
                        <Button Grid.Column="3" Click="OnAddAttachmentClick"
                                Width="28" Height="28" CornerRadius="14"
                                Background="Transparent" BorderThickness="0"
                                Padding="0" Margin="0,0,6,0" Cursor="Hand" ToolTip.Tip="Attach files or images (max 6)">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#26262B"/>
                                </Style>
                            </Button.Styles>
                            <TextBlock Text="+" FontSize="16" FontWeight="SemiBold" Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Right: Circular Morphing Action Button -->
                        <Panel Grid.Column="4" VerticalAlignment="Center">
                            <!-- Stop Button (busy or recording) -->
                            <Button Command="{Binding StopCommand}"
                                    Width="34" Height="34" CornerRadius="17"
                                    Background="#E4E4E7" Foreground="#18181B" Padding="0" Cursor="Hand"
                                    IsVisible="{Binding IsBusy}" ToolTip.Tip="Stop agent">
                                <TextBlock Text="⏹" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Send Up-Arrow Button (has text or attachments) -->
                            <Button Command="{Binding SendCommand}"
                                    Width="34" Height="34" CornerRadius="17"
                                    Background="#E4E4E7" Foreground="#18181B" Padding="0" Cursor="Hand"
                                    IsVisible="{Binding HasTextToSend}" ToolTip.Tip="Send prompt (Enter)">
                                <TextBlock Text="↑" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Mic Voice Button (empty text, idle) -->
                            <Button Command="{Binding ToggleVoiceRecordingCommand}"
                                    Width="34" Height="34" CornerRadius="17"
                                    Background="#E4E4E7" Foreground="#18181B" Padding="0" Cursor="Hand"
                                    IsVisible="{Binding ShowMicButton}" ToolTip.Tip="Voice prompt">
                                <TextBlock Text="🎙️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Panel>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
