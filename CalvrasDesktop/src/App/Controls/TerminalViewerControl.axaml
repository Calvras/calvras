<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Calvras.App.Controls.TerminalViewerControl">
    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Margin="0,4,0,4">
        <Grid RowDefinitions="Auto,Auto">
            <!-- Terminal Header -->
            <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="8,5" CornerRadius="6,6,0,0">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text=">_" Foreground="#A855F7" FontWeight="Bold" FontFamily="Consolas, Menlo, Monospace" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Grid.Column="1" Text="$" Foreground="#8B949E" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Name="CommandText" Text="{Binding Command}" Foreground="#F0F6FC" FontFamily="Consolas, Menlo, Monospace" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                    <!-- Duration Badge -->
                    <TextBlock Grid.Column="3" Text="{Binding DurationMs, StringFormat='{}{0}ms'}" Foreground="#8B949E" FontSize="10" VerticalAlignment="Center" Margin="8,0,8,0" IsVisible="{Binding DurationMs, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                    <!-- Exit code badge -->
                    <Border Grid.Column="4" Background="#1B4728" BorderBrush="#238636" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ExitCode, StringFormat='{}exit {0}'}" Foreground="#3FB950" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Terminal Output Body -->
            <Border Grid.Row="1" Padding="10,8" MaxHeight="220" IsVisible="{Binding Output, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <SelectableTextBlock Text="{Binding Output}" Foreground="#C9D1D9" FontFamily="Consolas, Menlo, Monospace" FontSize="11" LineHeight="17"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</UserControl>
