<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Calvras.App.Controls.TerminalViewerControl">
    <Border Background="#0A0A0B" BorderBrush="#222226" BorderThickness="1" CornerRadius="8" Margin="0,3,0,3">
        <StackPanel>
            <!-- Header: $ command  duration  exit code -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="12,8,12,8">
                <TextBlock Grid.Column="0" Text="$" Foreground="#555560"
                           FontFamily="Consolas,Menlo,Monospace" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Command}" Foreground="#C9D1D9"
                           FontFamily="Consolas,Menlo,Monospace" FontSize="11"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding DurationMs, StringFormat='{}{0}ms'}"
                           Foreground="#444450" FontSize="10" VerticalAlignment="Center"
                           Margin="12,0,8,0"
                           IsVisible="{Binding DurationMs, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <Border Grid.Column="3" Name="ExitBadge" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                    <TextBlock Name="ExitText"
                               Text="{Binding ExitCode, StringFormat='{}exit {0}'}"
                               FontSize="10" FontWeight="Medium"
                               FontFamily="Consolas,Menlo,Monospace"/>
                </Border>
            </Grid>
            <!-- Output body -->
            <Border BorderBrush="#1A1A1E" BorderThickness="0,1,0,0" Padding="12,8" MaxHeight="200"
                    IsVisible="{Binding Output, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <SelectableTextBlock Text="{Binding Output}" Foreground="#8B8B96"
                                        FontFamily="Consolas,Menlo,Monospace" FontSize="11"
                                        LineHeight="16" TextWrapping="NoWrap"/>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
