    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.2.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="10.0.13" />
    <PackageReference Include="Velopack" Version="0.0.915" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Calvras.Core.csproj" />
    <ProjectReference Include="..\Data\Calvras.Data.csproj" />
  </ItemGroup>
</Project>
