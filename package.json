{
  "name": "kraken",
  "version": "1.0.0",
  "description": "Kraken — The AI Coding Agent",
  "main": "main.js",
  "author": "Calvras",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build": "electron-builder --win --mac --linux",
    "publish": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "dev.getkraken.app",
    "productName": "Kraken",
    "copyright": "Copyright © 2026 Calvras",
    "icon": "build/icon.png",
    "publish": {
      "provider": "github",
      "owner": "Calvras",
      "repo": "calvras",
      "releaseType": "release"
    },
    "files": [
      "app.html",
      "app.css",
      "app.js",
      "server.js",
      "main.js",
      "avatar_milo.png",
      "kraken_logo.png",
      "build/**/*",
      "lib/**/*",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!**/*.map",
      "!**/test*",
      "!**/spec*",
      "!**/*.test.*",
      "!**/*.spec.*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.png",
      "uninstallerIcon": "build/icon.png",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kraken"
    },
    "extraMetadata": {
      "version": "1.0.0"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@solar-icons/react": "^2.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.3.9",
    "lucide-react": "^1.70.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.16.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12"
  }
}
